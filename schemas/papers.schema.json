{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/consciousness-sweep/papers.schema.json",
  "title": "Papers master row",
  "description": "One logical papers_master.csv row. Fields prefixed first_ preserve first-discovery provenance only; discoveries.csv preserves every result encounter. CSV blanks become JSON null only where permitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "paper_id", "title", "authors", "year", "doi", "url", "publication_status",
    "first_discovery_route", "first_discovery_parent", "first_discovery_query_id", "first_search_id", "first_seen_wave",
    "title_screen", "title_screen_reason", "abstract_screen", "abstract_screen_reason",
    "fulltext_priority", "fulltext_priority_reason", "fulltext_status", "fulltext_source",
    "missing_text_priority", "citation_expansion_status", "citation_expansion_reason",
    "duplicate_of", "duplicate_reason", "current_status", "notes"
  ],
  "properties": {
    "paper_id": { "type": "string", "pattern": "^P[0-9]{6}$" },
    "title": { "type": "string", "minLength": 1 },
    "authors": { "$ref": "#/$defs/nullableString" },
    "year": {
      "anyOf": [
        { "type": "integer", "minimum": 1800, "maximum": 3000 },
        { "type": "null" }
      ]
    },
    "doi": { "$ref": "#/$defs/nullableString" },
    "url": {
      "anyOf": [
        { "type": "string", "format": "uri" },
        { "type": "null" }
      ]
    },
    "publication_status": {
      "enum": ["published", "accepted-manuscript", "preprint", "unpublished", "unknown"]
    },
    "first_discovery_route": {
      "enum": [
        "empirical-seed", "review-anchor", "backward-citation", "forward-citation",
        "independent-query", "process-triggered-query", "manual-suggestion", "other"
      ]
    },
    "first_discovery_parent": {
      "anyOf": [
        { "type": "string", "pattern": "^P[0-9]{6}$" },
        { "type": "null" }
      ]
    },
    "first_discovery_query_id": { "$ref": "#/$defs/nullableString" },
    "first_search_id": {
      "anyOf": [
        { "type": "string", "pattern": "^[A-Za-z0-9._-]+_S[0-9]{6}$" },
        { "type": "null" }
      ]
    },
    "first_seen_wave": { "type": "integer", "minimum": 0 },
    "title_screen": { "enum": ["not-screened", "retain", "exclude"] },
    "title_screen_reason": { "$ref": "#/$defs/nullableString" },
    "abstract_screen": {
      "enum": ["not-screened", "screen-in", "screen-uncertain", "screen-out", "not-applicable"]
    },
    "abstract_screen_reason": { "$ref": "#/$defs/nullableString" },
    "fulltext_priority": { "enum": ["not-assigned", "high", "medium", "low"] },
    "fulltext_priority_reason": { "$ref": "#/$defs/nullableString" },
    "fulltext_status": {
      "enum": [
        "not-attempted", "retrieved-published", "retrieved-repository", "retrieved-preprint",
        "missing", "manually-requested", "unavailable", "not-required"
      ]
    },
    "fulltext_source": { "$ref": "#/$defs/nullableString" },
    "missing_text_priority": {
      "enum": ["none", "ask-text-high", "ask-text-medium", "unavailable-low-priority"]
    },
    "citation_expansion_status": {
      "enum": ["not-assessed", "pending", "in-progress", "complete", "not-applicable"]
    },
    "citation_expansion_reason": { "$ref": "#/$defs/nullableString" },
    "duplicate_of": {
      "anyOf": [
        { "type": "string", "pattern": "^P[0-9]{6}$" },
        { "type": "null" }
      ]
    },
    "duplicate_reason": { "$ref": "#/$defs/nullableString" },
    "current_status": {
      "enum": [
        "encountered", "title-retained", "title-excluded", "abstract-in", "abstract-uncertain",
        "abstract-out", "awaiting-fulltext", "fulltext-retrieved", "fulltext-evaluated",
        "duplicate", "unresolved"
      ]
    },
    "notes": { "$ref": "#/$defs/nullableString" }
  },
  "allOf": [
    {
      "if": { "properties": { "title_screen": { "enum": ["retain", "exclude"] } }, "required": ["title_screen"] },
      "then": { "properties": { "title_screen_reason": { "type": "string", "minLength": 1 } } }
    },
    {
      "if": { "properties": { "title_screen": { "const": "not-screened" } }, "required": ["title_screen"] },
      "then": { "properties": { "title_screen_reason": { "type": "null" } } }
    },
    {
      "if": { "properties": { "abstract_screen": { "enum": ["screen-in", "screen-uncertain"] } }, "required": ["abstract_screen"] },
      "then": {
        "properties": {
          "abstract_screen_reason": { "type": "string", "minLength": 1 },
          "fulltext_priority": { "enum": ["high", "medium", "low"] },
          "fulltext_priority_reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if": { "properties": { "abstract_screen": { "const": "screen-out" } }, "required": ["abstract_screen"] },
      "then": {
        "properties": {
          "abstract_screen_reason": { "type": "string", "minLength": 1 },
          "fulltext_priority": { "const": "not-assigned" },
          "fulltext_priority_reason": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "abstract_screen": { "enum": ["not-screened", "not-applicable"] } }, "required": ["abstract_screen"] },
      "then": {
        "properties": {
          "abstract_screen_reason": { "type": "null" },
          "fulltext_priority": { "const": "not-assigned" },
          "fulltext_priority_reason": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "fulltext_status": { "enum": ["retrieved-published", "retrieved-repository", "retrieved-preprint"] } }, "required": ["fulltext_status"] },
      "then": { "properties": { "fulltext_source": { "type": "string", "minLength": 1 } } }
    },
    {
      "if": { "properties": { "fulltext_status": { "enum": ["missing", "manually-requested", "unavailable"] } }, "required": ["fulltext_status"] },
      "then": { "properties": { "missing_text_priority": { "enum": ["ask-text-high", "ask-text-medium", "unavailable-low-priority"] } } }
    },
    {
      "if": { "properties": { "citation_expansion_status": { "enum": ["pending", "in-progress", "complete", "not-applicable"] } }, "required": ["citation_expansion_status"] },
      "then": { "properties": { "citation_expansion_reason": { "type": "string", "minLength": 1 } } }
    },
    {
      "if": { "properties": { "duplicate_of": { "type": "string" } }, "required": ["duplicate_of"] },
      "then": {
        "properties": {
          "duplicate_reason": { "type": "string", "minLength": 1 },
          "current_status": { "const": "duplicate" }
        }
      }
    },
    {
      "if": { "properties": { "current_status": { "const": "duplicate" } }, "required": ["current_status"] },
      "then": {
        "properties": {
          "duplicate_of": { "type": "string", "pattern": "^P[0-9]{6}$" },
          "duplicate_reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  ],
  "$defs": {
    "nullableString": {
      "anyOf": [{ "type": "string" }, { "type": "null" }]
    }
  }
}
