{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/consciousness-sweep/experiment_groups.schema.json",
  "title": "Physical experiment group",
  "description": "One durable row per physical experiment group, including groups that produce no qualifying X-to-Y comparison.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id", "paper_id", "experiment_label", "source_location",
    "physical_experiment_description", "pre_atomization_assessed",
    "citation_specific_x", "citation_awareness_attempt", "citation_functional_y",
    "bridge_near_neighbor", "bridge_disposition", "bridge_failed_ingredient",
    "bridge_rationale",
    "functional_structure_assessment", "functional_structure_reason",
    "disposition", "disposition_reason", "linked_comparison_ids",
    "support_roles", "notes"
  ],
  "properties": {
    "experiment_id": { "type": "string", "pattern": "^P[0-9]{6}_E[0-9]{2}$" },
    "paper_id": { "type": "string", "pattern": "^P[0-9]{6}$" },
    "experiment_label": { "type": "string", "minLength": 1 },
    "source_location": { "type": "string", "minLength": 1 },
    "physical_experiment_description": { "type": "string", "minLength": 1 },
    "pre_atomization_assessed": { "type": "boolean" },
    "citation_specific_x": { "$ref": "#/$defs/citationIngredient" },
    "citation_awareness_attempt": { "$ref": "#/$defs/citationIngredient" },
    "citation_functional_y": { "$ref": "#/$defs/citationIngredient" },
    "bridge_near_neighbor": { "enum": ["not-assessed", "yes", "no"] },
    "bridge_disposition": { "enum": ["not-assessed", "eligible", "not-eligible"] },
    "bridge_failed_ingredient": {
      "enum": ["not-applicable", "specific-x", "awareness-attempt", "functional-y"]
    },
    "bridge_rationale": { "$ref": "#/$defs/nullableString" },
    "functional_structure_assessment": {
      "enum": ["not-assessed", "not-applicable", "scalar-justified", "factorial-functional-required"]
    },
    "functional_structure_reason": { "$ref": "#/$defs/nullableString" },
    "disposition": {
      "enum": ["not-assessed", "comparison-bearing", "support-only", "no-qualifying-comparison"]
    },
    "disposition_reason": { "$ref": "#/$defs/nullableString" },
    "linked_comparison_ids": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^P[0-9]{6}_E[0-9]{2}_C[0-9]{2}$" }
    },
    "support_roles": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "notes": { "$ref": "#/$defs/nullableString" }
  },
  "allOf": [
    {
      "if": { "properties": { "bridge_disposition": { "const": "eligible" } }, "required": ["bridge_disposition"] },
      "then": {
        "properties": {
          "bridge_near_neighbor": { "const": "yes" },
          "bridge_failed_ingredient": { "not": { "const": "not-applicable" } },
          "bridge_rationale": { "type": "string", "minLength": 20 }
        },
        "oneOf": [
          { "properties": {
            "citation_specific_x": { "const": "failed" },
            "citation_awareness_attempt": { "const": "present" },
            "citation_functional_y": { "const": "present" },
            "bridge_failed_ingredient": { "const": "specific-x" }
          } },
          { "properties": {
            "citation_specific_x": { "const": "present" },
            "citation_awareness_attempt": { "const": "failed" },
            "citation_functional_y": { "const": "present" },
            "bridge_failed_ingredient": { "const": "awareness-attempt" }
          } },
          { "properties": {
            "citation_specific_x": { "const": "present" },
            "citation_awareness_attempt": { "const": "present" },
            "citation_functional_y": { "const": "failed" },
            "bridge_failed_ingredient": { "const": "functional-y" }
          } }
        ]
      }
    },
    {
      "if": { "properties": { "bridge_disposition": { "enum": ["not-assessed", "not-eligible"] } }, "required": ["bridge_disposition"] },
      "then": { "properties": { "bridge_failed_ingredient": { "const": "not-applicable" } } }
    },
    {
      "if": { "properties": { "pre_atomization_assessed": { "const": false } }, "required": ["pre_atomization_assessed"] },
      "then": { "properties": {
        "functional_structure_assessment": { "const": "not-assessed" },
        "functional_structure_reason": { "type": "null" },
        "disposition": { "const": "not-assessed" },
        "disposition_reason": { "type": "null" },
        "linked_comparison_ids": { "maxItems": 0 }
      } }
    },
    {
      "if": { "properties": { "pre_atomization_assessed": { "const": true } }, "required": ["pre_atomization_assessed"] },
      "then": { "properties": {
        "functional_structure_assessment": { "not": { "const": "not-assessed" } },
        "functional_structure_reason": { "type": "string", "minLength": 1 },
        "disposition": { "not": { "const": "not-assessed" } },
        "disposition_reason": { "type": "string", "minLength": 1 }
      } }
    },
    {
      "if": { "properties": { "disposition": { "const": "comparison-bearing" } }, "required": ["disposition"] },
      "then": { "properties": { "linked_comparison_ids": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "disposition": { "enum": ["support-only", "no-qualifying-comparison"] } }, "required": ["disposition"] },
      "then": { "properties": { "linked_comparison_ids": { "maxItems": 0 } } }
    }
  ],
  "$defs": {
    "citationIngredient": { "enum": ["not-assessed", "present", "failed", "unclear"] },
    "nullableString": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
  }
}
