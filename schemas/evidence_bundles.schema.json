{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/consciousness-sweep/evidence_bundles.schema.json",
  "title": "Scientific evidence bundle",
  "description": "One bundle supports one named premise of one focal comparison. It is a scientific argument, not an execution cache.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_bundle_id", "focal_comparison_id", "supported_premise",
    "premise_description", "route_label", "required_member_keys",
    "bundle_status", "bundle_reason", "notes"
  ],
  "properties": {
    "evidence_bundle_id": {
      "type": "string", "pattern": "^[A-Za-z0-9._-]+_EB[0-9]{6}$"
    },
    "focal_comparison_id": {
      "type": "string", "pattern": "^P[0-9]{6}_E[0-9]{2}_C[0-9]{2}$"
    },
    "supported_premise": {
      "enum": [
        "awareness-A", "first-order-evidence-E", "E-diagnostic", "meaningful-Y/F",
        "unaware-capacity", "awareness-effect", "null/no-detectable-difference",
        "equivalence", "statistical-inference", "Meyen-role", "interpretation", "other"
      ]
    },
    "premise_description": { "type": "string", "minLength": 1 },
    "route_label": { "type": "string", "minLength": 1 },
    "required_member_keys": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "bundle_status": { "enum": ["complete", "incomplete", "conflicted"] },
    "bundle_reason": { "type": "string", "minLength": 1 },
    "notes": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
  }
}
