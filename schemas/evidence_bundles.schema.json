{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/consciousness-sweep/evidence_bundles.schema.json",
  "title": "Scientific evidence bundle",
  "description": "One bundle supports one named premise of one focal comparison. It is a scientific argument, not an execution cache.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_bundle_id", "focal_comparison_id", "supported_premise",
    "premise_description", "route_label", "required_member_keys",
    "bundle_status", "bundle_reason", "contrast_integrity_alternative",
    "contrast_integrity_anchor_type", "contrast_integrity_anchor_source_location",
    "contrast_integrity_viability_reason", "contrast_integrity_prediction",
    "contrast_integrity_control_member_key", "contrast_integrity_resolution",
    "contrast_integrity_resolution_reason", "notes"
  ],
  "properties": {
    "evidence_bundle_id": {
      "type": "string", "pattern": "^[A-Za-z0-9._-]+_EB[0-9]{6}$"
    },
    "focal_comparison_id": {
      "type": "string", "pattern": "^P[0-9]{6}_E[0-9]{2}_C[0-9]{2}$"
    },
    "supported_premise": {
      "enum": [
        "awareness-A", "first-order-evidence-E", "E-diagnostic", "meaningful-Y/F",
        "unaware-capacity", "awareness-effect", "null/no-detectable-difference",
        "equivalence", "statistical-inference", "Meyen-role", "interpretation", "other"
      ]
    },
    "premise_description": { "type": "string", "minLength": 1 },
    "route_label": { "type": "string", "minLength": 1 },
    "required_member_keys": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "bundle_status": { "enum": ["complete", "incomplete", "conflicted"] },
    "bundle_reason": { "type": "string", "minLength": 1 },
    "contrast_integrity_alternative": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "contrast_integrity_anchor_type": {
      "enum": [
        "design-imposed-difference", "directly-measured-difference",
        "reported-behavioral-evidence", "manipulation-check-or-control",
        "other-direct-design-evidence", "none"
      ]
    },
    "contrast_integrity_anchor_source_location": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "contrast_integrity_viability_reason": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "contrast_integrity_prediction": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "contrast_integrity_control_member_key": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "contrast_integrity_resolution": { "enum": ["ruled-out", "unresolved", "not-applicable"] },
    "contrast_integrity_resolution_reason": { "type": "string", "minLength": 1 },
    "notes": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
  },
  "allOf": [
    {
      "if": { "properties": { "supported_premise": { "not": { "const": "E-diagnostic" } } }, "required": ["supported_premise"] },
      "then": { "properties": {
        "contrast_integrity_alternative": { "type": "null" },
        "contrast_integrity_anchor_type": { "const": "none" },
        "contrast_integrity_anchor_source_location": { "type": "null" },
        "contrast_integrity_viability_reason": { "type": "null" },
        "contrast_integrity_prediction": { "type": "null" },
        "contrast_integrity_control_member_key": { "type": "null" },
        "contrast_integrity_resolution": { "const": "not-applicable" }
      } }
    },
    {
      "if": { "properties": { "contrast_integrity_resolution": { "const": "ruled-out" } }, "required": ["contrast_integrity_resolution"] },
      "then": { "properties": {
        "contrast_integrity_alternative": { "type": "string", "minLength": 1 },
        "contrast_integrity_anchor_type": { "not": { "const": "none" } },
        "contrast_integrity_anchor_source_location": { "type": "string", "minLength": 1 },
        "contrast_integrity_viability_reason": { "type": "string", "minLength": 1 },
        "contrast_integrity_prediction": { "type": "string", "minLength": 1 },
        "contrast_integrity_control_member_key": { "type": "string", "minLength": 1 }
      } }
    },
    {
      "if": { "properties": { "contrast_integrity_resolution": { "const": "unresolved" } }, "required": ["contrast_integrity_resolution"] },
      "then": { "properties": {
        "contrast_integrity_alternative": { "type": "string", "minLength": 1 },
        "contrast_integrity_anchor_type": { "not": { "const": "none" } },
        "contrast_integrity_anchor_source_location": { "type": "string", "minLength": 1 },
        "contrast_integrity_viability_reason": { "type": "string", "minLength": 1 },
        "contrast_integrity_prediction": { "type": "string", "minLength": 1 },
        "contrast_integrity_control_member_key": { "type": "string", "minLength": 1 }
      } }
    },
    {
      "if": { "properties": { "contrast_integrity_resolution": { "const": "not-applicable" } }, "required": ["contrast_integrity_resolution"] },
      "then": { "properties": {
        "contrast_integrity_alternative": { "type": "null" },
        "contrast_integrity_anchor_type": { "const": "none" },
        "contrast_integrity_anchor_source_location": { "type": "null" },
        "contrast_integrity_viability_reason": { "type": "null" },
        "contrast_integrity_prediction": { "type": "null" },
        "contrast_integrity_control_member_key": { "type": "null" }
      } }
    }
  ]
}
