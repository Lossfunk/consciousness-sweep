{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/consciousness-sweep/decision_log.schema.json",
  "title": "Decision log event",
  "description": "One append-only JSON object per decision_log.jsonl line.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id", "run_id", "timestamp", "entity_type", "entity_id", "decision_type",
    "field", "old_value", "new_value", "reason", "source_location", "agent"
  ],
  "properties": {
    "decision_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+_D[0-9]{6}$" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "entity_type": { "enum": ["paper", "experiment", "comparison", "search", "discovery", "missing_text", "auxiliary_source", "evidence_bundle", "evidence_link", "evidence_assessment", "fulltext_asset", "run"] },
    "entity_id": { "type": "string", "minLength": 1 },
    "decision_type": { "type": "string", "minLength": 1 },
    "field": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "old_value": {},
    "new_value": {},
    "reason": { "type": "string", "minLength": 1 },
    "source_location": { "type": "string" },
    "agent": { "type": "string", "minLength": 1 }
  }
}
