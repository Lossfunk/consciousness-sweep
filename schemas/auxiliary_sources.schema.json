{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/consciousness-sweep/auxiliary_sources.schema.json",
  "title": "Reusable classification-critical auxiliary source",
  "description": "One acquired auxiliary work per logical source/version. Separate evidence links record each scientific use; consultation alone never enters the candidate pool.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "auxiliary_id", "citation", "doi", "url", "identity_reason", "article_version",
    "retrieval_status", "local_fulltext_path", "file_sha256", "obtained_at", "obtained_by",
    "acquisition_route", "verification_reason", "notes"
  ],
  "properties": {
    "auxiliary_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+_AUX[0-9]{6}$" },
    "citation": { "type": "string", "minLength": 1 },
    "doi": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "url": { "anyOf": [{ "type": "string", "format": "uri" }, { "type": "null" }] },
    "identity_reason": { "type": "string", "minLength": 1 },
    "article_version": { "type": "string", "minLength": 1 },
    "retrieval_status": { "enum": ["not-attempted", "retrieved", "unavailable", "unresolved"] },
    "local_fulltext_path": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "file_sha256": { "anyOf": [{ "type": "string", "pattern": "^[a-f0-9]{64}$" }, { "type": "null" }] },
    "obtained_at": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
    "obtained_by": { "anyOf": [{ "enum": ["agent", "user", "preexisting"] }, { "type": "null" }] },
    "acquisition_route": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "verification_reason": { "type": "string", "minLength": 1 },
    "notes": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
  },
  "allOf": [
    {
      "if": { "properties": { "retrieval_status": { "const": "retrieved" } }, "required": ["retrieval_status"] },
      "then": {
        "properties": {
          "local_fulltext_path": { "type": "string", "minLength": 1 },
          "file_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "obtained_at": { "type": "string", "format": "date-time" },
          "obtained_by": { "enum": ["agent", "user", "preexisting"] },
          "acquisition_route": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if": { "properties": { "retrieval_status": { "enum": ["not-attempted", "unavailable", "unresolved"] } }, "required": ["retrieval_status"] },
      "then": {
        "properties": {
          "local_fulltext_path": { "type": "null" },
          "file_sha256": { "type": "null" },
          "obtained_at": { "type": "null" },
          "obtained_by": { "type": "null" },
          "acquisition_route": { "type": "null" }
        }
      }
    }
  ]
}
